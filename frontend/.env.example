# Microsoft Entra ID (Azure AD) SPA sign-in
VITE_AZURE_AD_CLIENT_ID=your-spa-client-id
VITE_AZURE_AD_TENANT_ID=your-tenant-id
# Redirect URI must be registered as a "Single-page application" redirect in Entra ID
VITE_AZURE_AD_REDIRECT_URI=http://localhost:3000
# Set to "false" to bypass sign-in for local UI work
VITE_AUTH_ENABLED=true
